# Path to llama.cpp's llama-cli. Leave as llama-cli if it is in PATH.
LLAMA_CLI=llama-cli

# Path to your Gemma 4 E4B Q4_K_M GGUF file.
GEMMA4_GGUF=models/gemma4-e4b-it-Q4_K_M.gguf

# Optional inference defaults.
PROMPT=請用繁體中文說明 Rust 呼叫 llama-cli 的流程。
SYSTEM_PROMPT=你是精準、簡潔且使用繁體中文回答的助理。
N_PREDICT=256
TEMP=0.7
TOP_P=0.95

# AI daily news defaults.
NTFY_TOPIC=https://ntfy.sh/wangsc_ainews
AI_NEWS_SEND=0
AI_NEWS_DAYS=2
AI_NEWS_MAX_ITEMS=12
AI_NEWS_OUTPUT_MD=data/ai-news/latest.md
AI_NEWS_OUTPUT_JSON=web/public/latest-news.example.json
AI_NEWS_CHECKPOINT=data/ai-news/checkpoint.json
AI_NEWS_RESUME=0
AI_NEWS_FORCE=0
AI_NEWS_TEST_SEND=0
# Comma-separated RSS/Atom feeds. Leave empty to use built-in defaults.
# AI_NEWS_FEEDS=https://openai.com/news/rss.xml,https://www.technologyreview.com/topic/artificial-intelligence/feed/
